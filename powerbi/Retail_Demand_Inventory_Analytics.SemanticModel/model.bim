{
  "name": "Retail_Demand_Inventory_Analytics",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Users/singu/Documents/Coding/Machine Learning/ML Projects/Retail Demand/retail-demand-inventory-analytics/data/processed/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Store_ID",
            "dataType": "string",
            "sourceColumn": "Store_ID",
            "summarizeBy": "none"
          },
          {
            "name": "Product_ID",
            "dataType": "string",
            "sourceColumn": "Product_ID",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Department",
            "dataType": "string",
            "sourceColumn": "Department",
            "summarizeBy": "none"
          },
          {
            "name": "Units_Sold",
            "dataType": "int64",
            "sourceColumn": "Units_Sold",
            "summarizeBy": "none"
          },
          {
            "name": "Unit_Price",
            "dataType": "double",
            "sourceColumn": "Unit_Price",
            "summarizeBy": "none"
          },
          {
            "name": "Sales_Revenue",
            "dataType": "double",
            "sourceColumn": "Sales_Revenue",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Week",
            "dataType": "int64",
            "sourceColumn": "Week",
            "summarizeBy": "none"
          },
          {
            "name": "Day_of_Week",
            "dataType": "string",
            "sourceColumn": "Day_of_Week",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"retail_sales.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Date\", type date}, {\"Store_ID\", type text}, {\"Product_ID\", type text}, {\"Category\", type text}, {\"Department\", type text}, {\"Units_Sold\", Int64.Type}, {\"Unit_Price\", type number}, {\"Sales_Revenue\", type number}, {\"Month\", type text}, {\"Week\", Int64.Type}, {\"Day_of_Week\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales Revenue",
            "expression": "SUM(Sales[Sales_Revenue])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Total Units Sold",
            "expression": "SUM(Sales[Units_Sold])",
            "formatString": "#,##0"
          },
          {
            "name": "Average Daily Units Sold",
            "expression": "DIVIDE([Total Units Sold], COUNTROWS(VALUES(DimDate[Date])))",
            "formatString": "#,##0.00"
          },
          {
            "name": "Total Products",
            "expression": "DISTINCTCOUNT(Sales[Product_ID])",
            "formatString": "#,##0"
          },
          {
            "name": "Total Stores",
            "expression": "DISTINCTCOUNT(Sales[Store_ID])",
            "formatString": "#,##0"
          },
          {
            "name": "Revenue Contribution %",
            "expression": "DIVIDE([Total Sales Revenue], CALCULATE([Total Sales Revenue], ALLSELECTED(DimProduct[Product_ID])))",
            "formatString": "0.0%"
          },
          {
            "name": "A-Class Revenue",
            "expression": "CALCULATE([Total Sales Revenue], KEEPFILTERS(DimProduct[ABC_Class] = \"A\"))",
            "formatString": "$#,##0.00"
          },
          {
            "name": "A-Class Product Count",
            "expression": "CALCULATE([Total Products], KEEPFILTERS(DimProduct[ABC_Class] = \"A\"))",
            "formatString": "#,##0"
          },
          {
            "name": "B-Class Product Count",
            "expression": "CALCULATE([Total Products], KEEPFILTERS(DimProduct[ABC_Class] = \"B\"))",
            "formatString": "#,##0"
          },
          {
            "name": "C-Class Product Count",
            "expression": "CALCULATE([Total Products], KEEPFILTERS(DimProduct[ABC_Class] = \"C\"))",
            "formatString": "#,##0"
          },
          {
            "name": "Average Safety Stock",
            "expression": "AVERAGE(Inventory[Safety_Stock])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Average Reorder Point",
            "expression": "AVERAGE(Inventory[Reorder_Point])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Average Daily Demand",
            "expression": "AVERAGE(Inventory[Average_Daily_Demand])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Demand Variability",
            "expression": "AVERAGE(Inventory[Demand_Standard_Deviation])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Fast-Moving Product Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Inventory[Product_ID]), KEEPFILTERS(DimProduct[Movement_Class] = \"Fast Moving\"))",
            "formatString": "#,##0"
          },
          {
            "name": "Scenario Reorder Point",
            "expression": "AVERAGE(Sensitivity[Reorder_Point])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Scenario Safety Stock",
            "expression": "AVERAGE(Sensitivity[Safety_Stock])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Assumed Lead Time",
            "expression": "MAX(Inventory[Assumed_Lead_Time_Days])",
            "formatString": "#,##0"
          },
          {
            "name": "Baseline Product Revenue",
            "expression": "SUM(DimProduct[Total_Revenue])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Baseline Cumulative Revenue %",
            "expression": "DIVIDE(MAX(DimProduct[Cumulative_Revenue_Percent]),100)",
            "formatString": "0.0%"
          },
          {
            "name": "Top 10 Revenue",
            "expression": "VAR p = SELECTEDVALUE(DimProduct[Product_ID]) RETURN IF(CONTAINS(TOPN(10, ALLSELECTED(DimProduct[Product_ID]), [Total Sales Revenue], DESC, DimProduct[Product_ID], ASC), DimProduct[Product_ID], p), [Total Sales Revenue])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Top 10 Daily Units",
            "expression": "VAR p = SELECTEDVALUE(DimProduct[Product_ID]) RETURN IF(CONTAINS(TOPN(10, ALLSELECTED(DimProduct[Product_ID]), [Average Daily Units Sold], DESC, DimProduct[Product_ID], ASC), DimProduct[Product_ID], p), [Average Daily Units Sold])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Bottom 10 Daily Units",
            "expression": "VAR p = SELECTEDVALUE(DimProduct[Product_ID]) RETURN IF(CONTAINS(TOPN(10, ALLSELECTED(DimProduct[Product_ID]), [Average Daily Units Sold], ASC, DimProduct[Product_ID], ASC), DimProduct[Product_ID], p), [Average Daily Units Sold])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Overview Title",
            "expression": "\"RETAIL DEMAND & INVENTORY ANALYTICS\"",
            "formatString": "#,##0"
          },
          {
            "name": "Products Title",
            "expression": "\"ABC & PRODUCT ANALYSIS | fixed full-period classes\"",
            "formatString": "#,##0"
          },
          {
            "name": "Inventory Title",
            "expression": "\"INVENTORY PLANNING | estimates: 7-day lead time, 95% service\"",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "DimDate",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Week",
            "dataType": "int64",
            "sourceColumn": "Week",
            "summarizeBy": "none"
          },
          {
            "name": "Day_of_Week",
            "dataType": "string",
            "sourceColumn": "Day_of_Week",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"dim_date.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Date\", type date}, {\"Month\", type text}, {\"Week\", Int64.Type}, {\"Day_of_Week\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
